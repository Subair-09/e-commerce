# MongoDB Database Configuration
# Provide a MongoDB connection string (e.g. MongoDB Atlas or self-hosted MongoDB instance)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aura_ecommerce?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/aura_store
MONGODB_URI=
MONGODB_DB_NAME=aura_ecommerce

# Azure Storage Account Configuration
# Option 1: Primary Connection String (Recommended)
# Example: DefaultEndpointsProtocol=https;AccountName=mystorageaccount;AccountKey=abc123xyz...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# Option 2: Account Name + Key or SAS Token
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_SAS_TOKEN=

# Default Container Name (will be auto-created if it doesn't exist, e.g., 'auraassets')
AZURE_STORAGE_CONTAINER_NAME=auraassets

# Paystack Payment Gateway Configuration
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
